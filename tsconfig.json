{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "components",
    "hooks",
    "lib",
    "sanity/env.ts",
    "sanity/schemaTypes",
    "sanity/structure.ts",
    "sanity.config.ts",
    "vite.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}