{
  "name": "selfbyt-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/generate-brand-assets.mjs",
    "assets:social": "node scripts/generate-social-assets.mjs",
    "seed:products": "node scripts/seed-products.mjs",
    "reset:sanity": "node scripts/reset-sanity.mjs",
    "start": "node scripts/serve.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "npm run build && wrangler deploy",
    "test:worker": "node --test tests/worker.test.mjs"
  },
